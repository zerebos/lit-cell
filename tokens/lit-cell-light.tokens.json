{
  "$description": "Lit Cell Light, the light variant of the Lit Cell color schemes. Generated files are built from this one; see SPEC.md.",
  "$extensions": {
    "dev.zincterminal": {
      "name": "Lit Cell Light",
      "variant": "light",
      "author": "Zerebos (https://github.com/zerebos)"
    }
  },
  "base": {
    "$type": "color",
    "background": {
      "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9569, 0.9373], "hex": "#F1F4EF" },
      "$description": "Main ground.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "ground"
        }
      }
    },
    "foreground": {
      "$value": { "colorSpace": "srgb", "components": [0.1059, 0.149, 0.1255], "hex": "#1B2620" },
      "$description": "Body text, identifiers.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "text"
        }
      }
    },
    "cursor": {
      "$value": { "colorSpace": "srgb", "components": [0.0431, 0.4784, 0.2941], "hex": "#0B7A4B" },
      "$description": "Text cursor; the one brightest thing on screen.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "text"
        }
      }
    },
    "cursor-text": {
      "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9569, 0.9373], "hex": "#F1F4EF" },
      "$description": "Text under a block cursor."
    },
    "selection": {
      "$value": { "colorSpace": "srgb", "components": [0.7961, 0.902, 0.8392], "hex": "#CBE6D6" },
      "$description": "Selection background.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "surface",
          "text": "{base.selection-text}"
        }
      }
    },
    "selection-text": {
      "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0745, 0.0667], "hex": "#0F1311" },
      "$description": "Text inside a selection.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "text",
          "on": "{base.selection}"
        }
      }
    }
  },
