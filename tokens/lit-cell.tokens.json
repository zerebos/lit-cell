{
  "$description": "Lit Cell, the dark variant of the Lit Cell color schemes. Generated files are built from this one; see SPEC.md.",
  "$extensions": {
    "dev.zincterminal": {
      "name": "Lit Cell",
      "variant": "dark",
      "author": "Zerebos (https://github.com/zerebos)"
    }
  },
  "base": {
    "$type": "color",
    "background": {
      "$value": { "colorSpace": "srgb", "components": [0.0471, 0.0667, 0.0549], "hex": "#0C110E" },
      "$description": "Main ground.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "ground"
        }
      }
    },
    "foreground": {
      "$value": { "colorSpace": "srgb", "components": [0.8118, 0.8667, 0.8275], "hex": "#CFDDD3" },
      "$description": "Body text, identifiers.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "text"
        }
      }
    },
    "cursor": {
      "$value": { "colorSpace": "srgb", "components": [0.2392, 0.949, 0.6275], "hex": "#3DF2A0" },
      "$description": "Text cursor; the one brightest thing on screen.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "text"
        }
      }
    },
    "cursor-text": {
      "$value": { "colorSpace": "srgb", "components": [0.0471, 0.0667, 0.0549], "hex": "#0C110E" },
      "$description": "Text under a block cursor."
    },
    "selection": {
      "$value": { "colorSpace": "srgb", "components": [0.1176, 0.2706, 0.2], "hex": "#1E4533" },
      "$description": "Selection background.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "surface",
          "text": "{base.selection-text}"
        }
      }
    },
    "selection-text": {
      "$value": { "colorSpace": "srgb", "components": [0.9294, 0.9373, 0.9176], "hex": "#EDEFEA" },
      "$description": "Text inside a selection.",
      "$extensions": {
        "dev.zincterminal": {
          "use": "text",
          "on": "{base.selection}"
        }
      }
    }
  },
